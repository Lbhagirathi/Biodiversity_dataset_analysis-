    "import geopandas as gpd\n",
    "\n",
    "denmark_regions = gpd.read_file(\"../GADM Denmark Shapefile/gadm41_DNK_1.shp\")\n",
    "denmark_regions = denmark_regions.to_crs(epsg=4326)\n",
    "denmark_regions.to_file(\"../outputs/denmark_admin.gpkg\", driver=\"GPKG\")\n",
    "print(\"Saved.\")"
   ]
  }
